<UserControl x:Class="Games_Factory.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Games_Factory.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#F0F2F5">


    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🛒" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Tu Carrito de Compra" FontSize="28" FontWeight="Black" Foreground="#333" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50">
                                                    <TextBlock Text="Tu carrito está vacío 😔" FontSize="24" Foreground="Gray" HorizontalAlignment="Center" FontWeight="Bold"/>
                                                    <TextBlock Text="¡Anímate a explorar nuestro catálogo de videojuegos!" FontSize="16" Foreground="DarkGray" HorizontalAlignment="Center" Margin="0,10"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="0,0,10,15" Padding="15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border CornerRadius="5" ClipToBounds="True">
                                        <Image Source="{Binding Videojuego.Producto.Imagen, Converter={StaticResource UrlImageConverter}}" Stretch="Uniform" Height="100"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                        <TextBlock Text="{Binding Videojuego.Producto.Nombre}" FontSize="20" FontWeight="Bold" Foreground="#333" TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,5">
                                            <Border Background="#EEE" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Videojuego.TipoConsola}" FontSize="12" Foreground="#000" FontWeight="Bold"/>
                                            </Border>

                                            <Border Background="#FFEBEE" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{Binding Videojuego.Categoria}" FontSize="12" Foreground="#D32F2F" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" FontSize="14" Foreground="#000" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='{}{0:N2} €'}" FontSize="22" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center" Margin="20,0"/>

                                    <Button Grid.Column="3" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Cursor="Hand" Width="40" Height="40" ToolTip="Eliminar del carrito" Margin="10,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#FFF5F5"/>
                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                                <Setter Property="BorderBrush" Value="#FFCDCD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                                <TextBlock Text="🗑" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="1" Content="🡠 Seguir comprando" Command="{Binding ContinueShoppingCommand}" 
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,20,0,0" Foreground="#555" FontSize="16" FontWeight="SemiBold" Cursor="Hand"/>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="15" Padding="25" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Resumen del Pedido" FontSize="22" FontWeight="Black" Foreground="#333" Margin="0,0,0,20"/>

                <Grid Margin="0,10">
                    <TextBlock Text="Subtotal:" FontSize="16" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} €'}" FontSize="16" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,10">
                    <TextBlock Text="Impuestos:" FontSize="16" Foreground="#666"/>
                    <TextBlock Text="Incluidos" FontSize="16" Foreground="Green" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Margin="0,20"/>

                <Grid Margin="0,0,0,30">
                    <TextBlock Text="TOTAL:" FontSize="20" FontWeight="Black" Foreground="#333" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} €'}" FontSize="28" FontWeight="Black" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                </Grid>

                <Button Content="FINALIZAR COMPRA" Command="{Binding CheckoutCommand}" 
                        Foreground="White" FontWeight="Bold" FontSize="18" Height="55" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#D32F2F"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B71C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="🔒" Foreground="Gray" Margin="0,0,5,0"/>
                    <TextBlock Text="Pago 100% seguro y encriptado" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>


</UserControl>
