<UserControl x:Class="Games_Factory.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" ClipToBounds="True" Margin="0,0,2,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Direction="0" RenderingBias="Performance"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="280"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                            <Setter Property="Width" Value="0"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="280" To="0" Duration="0:0:0.25" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="0" To="280" Duration="0:0:0.25" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="25" Width="230" HorizontalAlignment="Left">

                    <Grid Margin="0,0,0,30">
                        <TextBlock Text="CATEGORÍAS" FontWeight="Black" FontSize="20" Foreground="#333" VerticalAlignment="Center"/>
                        <Button Command="{Binding ToggleFiltersCommand}" 
                             HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cerrar menú">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="5">
                                        <TextBlock x:Name="CloseIcon" Text="✕" FontWeight="Bold" FontSize="18" Foreground="#888"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseIcon" Property="Foreground" Value="#D32F2F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,0,0,30">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#444"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <Border x:Name="Border" Width="18" Height="18" CornerRadius="9" BorderThickness="2" BorderBrush="#AAA" Background="White" VerticalAlignment="Center">
                                                    <Border x:Name="CheckMark" Width="8" Height="8" CornerRadius="4" Background="#D32F2F" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ContentPresenter x:Name="Content" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="#D32F2F"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="#D32F2F"/>
                                                    <Setter TargetName="Content" Property="TextElement.FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton Content="Playstation" IsChecked="{Binding IsCatPlaystation}"/>
                        <RadioButton Content="Nintendo" IsChecked="{Binding IsCatNintendo}"/>
                        <RadioButton Content="Xbox" IsChecked="{Binding IsCatXbox}"/>
                        <RadioButton Content="PC" IsChecked="{Binding IsCatPC}"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,30" Background="#EEE"/>

                    <Button Command="{Binding FilterCommand}" Margin="0,0,0,10" Cursor="Hand" Height="45">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <TextBlock Text="APLICAR FILTROS" FontWeight="Bold" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ClearCommand}" Cursor="Hand" Height="45">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="BorderBrush" Value="#999"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <TextBlock Text="LIMPIAR SELECCIÓN" FontWeight="Bold" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                    <Setter Property="Foreground" Value="#333"/>
                                                    <Setter Property="BorderBrush" Value="#333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding ToggleFiltersCommand}" 
                 HorizontalAlignment="Left" Margin="30,20,0,10" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#DDD"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="15,8" CornerRadius="20">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☰" FontSize="16" Margin="0,0,8,0" Foreground="#555" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mostrar Filtros" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="BorderBrush" Value="#CCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="20,20,0,20">
                <ScrollViewer Padding="0,0,20,0">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Última Hora" FontSize="36" FontWeight="Black" Margin="0,0,0,30" Foreground="#333" HorizontalAlignment="Left"/>

                        <ItemsControl ItemsSource="{Binding NewsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectNewsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         CommandParameter="{Binding}" Margin="0,0,0,30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="12" ClipToBounds="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="3" Color="#000" RenderingBias="Performance"/>
                                                    </Border.Effect>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FAFAFA"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsWideLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="380"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Image Grid.Column="0"
                                                                Source="{Binding Imagen, Converter={StaticResource UrlImageConverter}}" 
                                                                Stretch="UniformToFill" Height="220"/>

                                                            <StackPanel Grid.Column="1" Margin="25" VerticalAlignment="Center">
                                                                <Border Background="#FFEBEE" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                                    <TextBlock Text="{Binding CategoriaNoticia}" FontSize="12" Foreground="#D32F2F" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Black" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                                <TextBlock Text="{Binding Descripcion}" FontSize="15" Foreground="#666" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis" LineHeight="22"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsWideLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <Image Source="{Binding Imagen, Converter={StaticResource UrlImageConverter}}" 
                                                                Stretch="UniformToFill" Height="220"/>

                                                            <StackPanel Margin="25">
                                                                <Border Background="#FFEBEE" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                                    <TextBlock Text="{Binding CategoriaNoticia}" FontSize="12" Foreground="#D32F2F" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="Black" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                                <TextBlock Text="{Binding Descripcion}" FontSize="15" Foreground="#666" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis" LineHeight="22"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Background="White">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer Padding="40">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
                            <Button Command="{Binding BackToListCommand}" 
                                 Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,20" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🡠" FontSize="18" Foreground="#555" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Volver a la lista" FontSize="16" FontWeight="Bold" Foreground="#555" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding SelectedNews.Titulo}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" Foreground="#333" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="{Binding SelectedNews.FechaCreacion, StringFormat='Publicado el {0:d}'}" Foreground="Gray"/>
                                <TextBlock Text=" | " Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedNews.CategoriaNoticia}" Foreground="#D32F2F" FontWeight="Bold"/>
                            </StackPanel>

                            <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,30">
                                <Image Source="{Binding SelectedNews.Imagen, Converter={StaticResource UrlImageConverter}}" MaxHeight="400" Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock Text="{Binding SelectedNews.Historia}" FontSize="18" LineHeight="28" TextWrapping="Wrap" TextAlignment="Justify" Foreground="#444"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
