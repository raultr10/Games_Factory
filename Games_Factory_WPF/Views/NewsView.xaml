<UserControl x:Class="Games_Factory.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E0E0E0" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="250"/>
                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3" DecelerationRatio="0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="250" Duration="0:0:0.3" DecelerationRatio="0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Margin="15">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="CATEGORÍAS" FontWeight="Bold" FontSize="18" Foreground="#333" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleFiltersCommand}" Content="✕" 
                            HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <RadioButton Content="Playstation" IsChecked="{Binding IsCatPlaystation}" Margin="0,5"/>
                <RadioButton Content="Nintendo" IsChecked="{Binding IsCatNintendo}" Margin="0,5"/>
                <RadioButton Content="Xbox" IsChecked="{Binding IsCatXbox}" Margin="0,5"/>
                <RadioButton Content="PC" IsChecked="{Binding IsCatPC}" Margin="0,5"/>

                <Separator Margin="0,20"/>

                <Button Content="FILTRAR" Command="{Binding FilterCommand}" 
                        Background="#D32F2F" Foreground="White" FontWeight="Bold" Height="35">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="VER TODAS" Command="{Binding ClearCommand}" 
                        Background="Transparent" BorderBrush="#333" BorderThickness="1" Foreground="#333" 
                        FontWeight="Bold" Height="35" Margin="0,10,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding ToggleFiltersCommand}" 
                    HorizontalAlignment="Left" Margin="20,10,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☰" FontSize="20" Margin="0,0,5,0"/>
                    <TextBlock Text="Categorías" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <Grid Grid.Row="1" Margin="20">

                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <TextBlock Text="Últimas Noticias" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>
                        <ItemsControl ItemsSource="{Binding NewsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectNewsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Margin="0,0,0,20" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="White" CornerRadius="8" Padding="0">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Imagen, Converter={StaticResource UrlImageConverter}}" Stretch="UniformToFill" Height="140" Grid.Column="0"/>
                                                        <StackPanel Grid.Column="1" Margin="20,10">
                                                            <TextBlock Text="{Binding Titulo}" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding CategoriaNoticia}" FontSize="12" Foreground="Gray" FontWeight="Bold" Margin="0,5"/>
                                                            <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Background="White">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNews, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer Padding="40">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Center">
                            <Button Command="{Binding BackToListCommand}" Content="🡠 Volver a la lista" 
                                    Background="Transparent" BorderThickness="0" Foreground="#555" FontSize="16" HorizontalAlignment="Left" Margin="0,0,0,20" Cursor="Hand"/>

                            <TextBlock Text="{Binding SelectedNews.Titulo}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                                <TextBlock Text="{Binding SelectedNews.FechaCreacion, StringFormat='Publicado el {0:d}'}" Foreground="Gray"/>
                                <TextBlock Text=" | " Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedNews.CategoriaNoticia}" Foreground="#D32F2F" FontWeight="Bold"/>
                            </StackPanel>

                            <Image Source="{Binding SelectedNews.Imagen, Converter={StaticResource UrlImageConverter}}" MaxHeight="400" Stretch="Uniform" Margin="0,0,0,30"/>
                            <TextBlock Text="{Binding SelectedNews.Historia}" FontSize="18" LineHeight="28" TextWrapping="Wrap" TextAlignment="Justify" Foreground="#444"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
