<UserControl x:Class="Games_Factory.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5"
             UseLayoutRounding="True" 
             SnapsToDevicePixels="True">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <Border Background="White" Width="400" CornerRadius="15" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="4" Color="#000" RenderingBias="Performance"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="INICIAR SESIÓN" FontSize="26" FontWeight="Black" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="¡Bienvenido de nuevo!" FontSize="14" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Correo Electrónico" FontWeight="Bold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                    <Border Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Height="45" Margin="0,0,0,20">
                        <TextBox Text="{Binding Email}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0" FontSize="15" Foreground="#333"/>
                    </Border>

                    <TextBlock Text="Contraseña" FontWeight="Bold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                    <Border Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Height="45" Margin="0,0,0,35">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="txtPass" Grid.Column="0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0" FontSize="15" Foreground="#333"/>

                            <TextBox x:Name="txtPassVisible" Grid.Column="0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="15,0" FontSize="15" Foreground="#333" Visibility="Collapsed" TextChanged="txtPassVisible_TextChanged"/>

                            <ToggleButton x:Name="btnShowPass" Grid.Column="1" Margin="0,0,10,0" Width="30" Height="30" Cursor="Hand" Click="btnShowPass_Click">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="EyeIcon" Text="👁" FontSize="18" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EyeIcon" Property="Foreground" Value="#555"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="EyeIcon" Property="Foreground" Value="#D32F2F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <Button Content="ENTRAR" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPass}" Height="50" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <TextBlock Text="{TemplateBinding Content}" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock HorizontalAlignment="Center" Margin="0,25,0,0" FontSize="14">
                        <Run Text="¿No tienes cuenta? " Foreground="#666"/>
                        <Hyperlink Command="{Binding RegisterNavCommand}" TextDecorations="None" Foreground="#D32F2F" FontWeight="Bold">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                            <Setter Property="Foreground" Value="#B71C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            Regístrate
                        </Hyperlink>
                    </TextBlock>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>
