<UserControl x:Class="Games_Factory.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" ClipToBounds="True" Margin="0,0,2,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" Direction="0"/>
            </Border.Effect>

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="280"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                            <Setter Property="Width" Value="0"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="280" To="0" Duration="0:0:0.25" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" From="0" To="280" Duration="0:0:0.25" FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="25" Width="230" HorizontalAlignment="Left">

                    <Grid Margin="0,0,0,30">
                        <TextBlock Text="CATEGORÍAS" FontWeight="Black" FontSize="20" Foreground="#333" VerticalAlignment="Center"/>

                        <Button Command="{Binding ToggleFiltersCommand}" 
                            HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cerrar filtros">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="5">
                                        <TextBlock x:Name="CloseIcon" Text="✕" FontWeight="Bold" FontSize="18" Foreground="#888"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseIcon" Property="Foreground" Value="#D32F2F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,0,0,30">
                        <StackPanel.Resources>
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#444"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <Border x:Name="Border" Width="18" Height="18" CornerRadius="9" BorderThickness="2" BorderBrush="#AAA" Background="White" VerticalAlignment="Center">
                                                    <Border x:Name="CheckMark" Width="8" Height="8" CornerRadius="4" Background="#D32F2F" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ContentPresenter x:Name="Content" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="#D32F2F"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="#D32F2F"/>
                                                    <Setter TargetName="Content" Property="TextElement.FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <RadioButton Content="Playstation" IsChecked="{Binding IsPlayStation}"/>
                        <RadioButton Content="Nintendo" IsChecked="{Binding IsNintendo}"/>
                        <RadioButton Content="Xbox" IsChecked="{Binding IsXbox}"/>
                        <RadioButton Content="PC" IsChecked="{Binding IsPC}"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,30" Background="#EEE"/>

                    <Button Command="{Binding FilterCommand}" Margin="0,0,0,10" Cursor="Hand" Height="45">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <TextBlock Text="APLICAR FILTROS" FontWeight="Bold" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#B71C1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ClearFiltersCommand}" Cursor="Hand" Height="45">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="BorderBrush" Value="#999"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                <TextBlock Text="LIMPIAR SELECCIÓN" FontWeight="Bold" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                    <Setter Property="Foreground" Value="#333"/>
                                                    <Setter Property="BorderBrush" Value="#333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding ToggleFiltersCommand}" 
                HorizontalAlignment="Left" Margin="30,20,0,10" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#DDD"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="15,8" CornerRadius="20">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☰" FontSize="16" Margin="0,0,8,0" Foreground="#555" VerticalAlignment="Center"/>
                                            <TextBlock Text="Mostrar Filtros" FontSize="14" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="BorderBrush" Value="#CCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <ScrollViewer Grid.Row="1" Padding="30,10,30,30" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding GamesList}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}" Margin="15" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="White" CornerRadius="12" Width="230" VerticalAlignment="Top">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" Opacity="0.1" ShadowDepth="4" Color="#000"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <Border CornerRadius="8" ClipToBounds="True" Margin="15,15,15,10" Height="220" Background="#F9F9F9">
                                                    <Image Source="{Binding Producto.Imagen, Converter={StaticResource UrlImageConverter}}" Stretch="Uniform"/>
                                                </Border>

                                                <TextBlock Text="{Binding Producto.Nombre}" FontSize="15" FontWeight="Black" Foreground="#333" TextWrapping="Wrap" Margin="15,0,15,10" TextAlignment="Left" MinHeight="40" MaxHeight="45" TextTrimming="CharacterEllipsis"/>

                                                <Grid Margin="15,0,15,15">
                                                    <TextBlock Text="{Binding Consola}" FontSize="13" Foreground="#888" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding Producto.Precio, StringFormat='{}{0:N2} €'}" FontSize="18" Foreground="#D32F2F" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
