<UserControl x:Class="Games_Factory.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E0E0E0" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="250"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="0" Duration="0:0:0.3" 
                                                         DecelerationRatio="0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="250" Duration="0:0:0.3" 
                                                         DecelerationRatio="0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Margin="15">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="FILTRAR POR" FontWeight="Bold" FontSize="18" Foreground="#333" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleFiltersCommand}" Content="✕" 
                            HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <TextBlock Text="CONSOLA" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="#555"/>
                <RadioButton Content="Nintendo" IsChecked="{Binding IsNintendo}" Margin="0,5"/>
                <RadioButton Content="PlayStation" IsChecked="{Binding IsPlayStation}" Margin="0,5"/>
                <RadioButton Content="Xbox" IsChecked="{Binding IsXbox}" Margin="0,5"/>
                <RadioButton Content="PC" IsChecked="{Binding IsPC}" Margin="0,5"/>

                <Separator Margin="0,20"/>

                <Button Content="APLICAR FILTROS" Command="{Binding FilterCommand}" 
                        Background="#333" Foreground="White" FontWeight="Bold" Height="35">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="LIMPIAR SELECCIÓN" Command="{Binding ClearFiltersCommand}" 
                        Background="Transparent" BorderBrush="#333" BorderThickness="1" Foreground="#333" 
                        FontWeight="Bold" Height="35" Margin="0,10,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding ToggleFiltersCommand}" 
                    HorizontalAlignment="Left" Margin="10,10,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFiltersOpen}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☰" FontSize="20" Margin="0,0,5,0"/>
                    <TextBlock Text="Mostrar Filtros" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <ScrollViewer Grid.Row="1" Padding="20">
                <ItemsControl ItemsSource="{Binding GamesList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}" Margin="10" Background="White" BorderBrush="#CCC" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White" CornerRadius="5" BorderThickness="1" BorderBrush="#DDD" Padding="10">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="5" Opacity="0.1" ShadowDepth="2"/>
                                            </Border.Effect>
                                            <StackPanel Width="160">
                                                <Image Source="{Binding Producto.Imagen, Converter={StaticResource UrlImageConverter}}" Height="220" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Producto.Nombre}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,5" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Producto.Precio, StringFormat={}{0}€}" Foreground="#D32F2F" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
