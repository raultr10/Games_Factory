<Window x:Class="Games_Factory.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Games_Factory.ViewModels"
        Title="Ilusion Games" Height="800" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B71C1C" Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GAMES-FACTORY" FontFamily="Segoe UI Black" FontSize="32" Foreground="White" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="5" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#333" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="INICIO" Command="{Binding NavigateHomeCommand}" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="Bold" Margin="10,0"/>
                    <Button Content="VIDEOJUEGOS" Command="{Binding NavigateGamesCommand}" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="Bold" Margin="10,0"/>
                    <Button Content="NOTICIAS" Command="{Binding NavigateNewsCommand}" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="Bold" Margin="10,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="White" CornerRadius="15" Margin="20,0" MaxWidth="400">
                    <Grid>
                        <TextBlock Text="🔍 Buscar..." Foreground="Gray" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="txtSearch" 
                                 Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Content="INICIAR SESIÓN" Command="{Binding NavigateLoginCommand}" Background="White" Foreground="Black" FontWeight="Bold" Padding="15,5">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserLoggedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="#555" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Content="SALIR" Command="{Binding LogoutCommand}" 
                                Background="#D32F2F" Foreground="White" FontWeight="Bold" Padding="15,5" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentView}"/>

        <Border Grid.Row="3" Background="#222">
            <TextBlock Text="© 2026 Ilusion Games - Frank SC" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
